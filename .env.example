# Database connections (local or Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reservas_iguape?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/reservas_iguape?schema=public"

# Security & Secrets
SESSION_SECRET="change-this-to-a-very-secure-random-32-bytes-string"
CRON_SECRET="change-this-to-a-very-secure-random-cron-secret-32"

# Initial Admin Credentials (used during seed)
ADMIN_EMAIL="admin@iguapeaparts.com"
ADMIN_PASSWORD="AdminPassword123!"

# Private Storage (receipts, RF-55)
RECEIPTS_DIR="storage/receipts"
